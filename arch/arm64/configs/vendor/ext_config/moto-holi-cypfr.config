#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_CYPFR_DTB=y

# Camera
CONFIG_AF_NOISE_ELIMINATION=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_CAMERA_CCI_INTF=m

# Charger
CONFIG_CW2217B_FG_MMI=m
CONFIG_MMI_CHARGER=m
CONFIG_MMI_DISCRETE_CHARGER=m
CONFIG_MMI_DISCRETE_CHARGER_CLASS=m
CONFIG_TYPEC_ADAPTER_CLASS=m
CONFIG_RT_PD_MANAGER=m
CONFIG_SGM4154X_CHARGER=m
CONFIG_TCPC_CLASS=m
CONFIG_TCPC_SGM7220=m
CONFIG_QPNP_ADAPTIVE_CHARGE=m

# Display
# CONFIG_REGULATOR_QPNP_LCDB is not set

# Fingerprint
CONFIG_INPUT_EGIS_FPS_MMI=m
CONFIG_INPUT_MISC_FPC1020=m
CONFIG_INPUT_MISC_FPC1020_SAVE_TO_CLASS_DEVICE=y

# FM
CONFIG_RADIO_ELNA=y

# LED indicator
CONFIG_LEDS_INDICATOR_PWM=m

# MMI
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MMI_RELAY=m
CONFIG_MMI_SYS_TEMP=m
CONFIG_MOTO_UTAGS=m
CONFIG_SENSORS_CLASS=m

# NFC
CONFIG_NFC_QTI_I2C=m

# Regulator
CONFIG_REGULATOR_WL2864C=m

# SAR
CONFIG_SARSENSOR_SX937X=m

# Touchscreen
CONFIG_INPUT_TOUCHSCREEN_MMI=y
CONFIG_TOUCHSCREEN_ILI_9882_MMI=m
CONFIG_TOUCHSCREEN_ILI_9882_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_TOUCHSCREEN_ILI_9882_MMI_NOTIFY_TOUCH_STATE=y
CONFIG_TOUCHSCREEN_ILI_9882_MMI_PANEL_NOTIFICATIONS=y
CONFIG_TOUCHSCREEN_ILI_9882_MMI_RESUME_BY_DDI=y
CONFIG_TOUCHSCREEN_ILI_9882_MMI_FW_PANEL=y
CONFIG_TOUCHSCREEN_ILI_9882_MMI_SUSPEND_PWROFF=y
CONFIG_TOUCHSCREEN_ILI_9882_MMI_ESD=y
CONFIG_TOUCHSCREEN_ILI_9882_MMI_GESTURE=y
CONFIG_DRM_PANEL_NOTIFICATIONS=y

# Charger
CONFIG_QG_LEGACY=y
CONFIG_USE_MMI_CHARGER=y

# UFS
# CONFIG_MICRON_UFSHID is not set

# Vibrator
CONFIG_REGULATOR_VIBRATOR_MMI=m
