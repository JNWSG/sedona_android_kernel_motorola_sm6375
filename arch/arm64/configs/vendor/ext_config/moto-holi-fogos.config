#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_FOGOS_DTB=y

# Audio
CONFIG_SND_SOC_FS1815=y

# Camera
CONFIG_AF_NOISE_ELIMINATION=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_CAMERA_CCI_INTF=y
CONFIG_CAMERA_FLASH_IIC_COMPATIBLE=y
CONFIG_MOT_DONGWOON_OIS_AF_DRIFT=y
CONFIG_MOT_SECURE_CAMERA=y
CONFIG_MOT_SENSOR_PRE_POWERUP=y

# Charger
CONFIG_MMI_SMBCHARGER_IIO=y
CONFIG_QPNP_ADAPTIVE_CHARGE=y

# Display
# CONFIG_REGULATOR_QPNP_LCDB is not set

# Fingerprint
CONFIG_INPUT_MISC_FPC1020=y
CONFIG_INPUT_MISC_FPC1020_SAVE_TO_CLASS_DEVICE=y
CONFIG_INPUT_GOODIX_FOD_MMI=y
CONFIG_GOODIX_DRM_PANEL_NOTIFICATIONS=y

# FM
CONFIG_RADIO_ELNA=y

# MMI
CONFIG_MMI_ANNOTATE=y
CONFIG_MMI_INFO=y
CONFIG_MMI_RELAY=y
CONFIG_MMI_SYS_TEMP=y
CONFIG_MOTO_UTAGS=y
CONFIG_SENSORS_CLASS=y

# NFC
CONFIG_NFC=y
CONFIG_SEC_NFC_PRODUCT_N5=y
CONFIG_SEC_NFC=y
CONFIG_SEC_NFC_IF_I2C=y

# Pinctrl
CONFIG_QUP0_SE2_AP=y

# SAR
CONFIG_SARSENSOR_SX937X=y

# Touchscreen
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_ESD=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_GTP_LAST_TIME=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_STOWED_MODE_EN=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_PM_BRL_SPI=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_USES_DOUBLE_TAP_CTRL=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_SET_TOUCH_STATE=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_RESUME_BY_DDI=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_LAST_TIME=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_STOWED_MODE_EN=y
CONFIG_BOARD_USES_DOUBLE_TAP_CTRL=y

# UFS
# CONFIG_UFSHPB is not set
# CONFIG_UFSTW is not set
# CONFIG_SCSI_SKHPB is not set
# CONFIG_MICRON_HPB is not set

# Vibrator
CONFIG_LDO_VIBRATOR_MMI=y
